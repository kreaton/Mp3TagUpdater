<Window x:Class="Mp3TagFromApi.Wpf.ApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply changes"
        Icon="app.ico"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <DockPanel>
            <TextBlock x:Name="WarningIcon" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7BA;"
                       FontSize="20" Margin="0,2,10,0" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Text="Apply the changes?" FontSize="18" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock x:Name="FolderText" Margin="0,4,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl x:Name="LinesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="•" Margin="4,0,10,0" />
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Modified dates are kept." Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel x:Name="RenamePanel" Margin="0,16,0,0" Visibility="Collapsed">
            <CheckBox x:Name="RenameBox" Content="_Rename the folder to the album's name" IsChecked="True"
                      Checked="OnRenameChanged" Unchecked="OnRenameChanged" />
            <TextBox x:Name="FolderNameBox" Margin="28,8,0,0" AutomationProperties.Name="New folder name"
                     ToolTip="The new name of the folder. Change it if you like." />
            <TextBlock x:Name="CurrentNameText" Margin="28,4,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ApplyButton" Content="Apply" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" Click="OnApply" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
