<Project Sdk="Microsoft.NET.Sdk">

  <!-- Companion to Mp3TagUpdater: tags and renames one folder of mp3 files as an album from Spotify or Discogs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mp3TagFromApi</AssemblyName>
    <RootNamespace>Mp3TagFromApi.Wpf</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mp3TagFromApi</Product>
    <Authors>Per Hejndorf</Authors>
    <Copyright>Copyright © 2026 Per Hejndorf</Copyright>
    <!-- Velopack's Program.Main replaces the generated WPF entry point -->
    <StartupObject>Mp3TagFromApi.Wpf.Program</StartupObject>
    <!-- WPF's built-in Fluent theme (ThemeMode) is still flagged experimental in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mp3Tag.Albums\Mp3Tag.Albums.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
