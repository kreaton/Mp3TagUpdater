<Window x:Class="Mp3TagUpdater.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mp3 Tag Updater"
        Icon="app.ico"
        Width="1100" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        Closing="OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Content="_Folder" Target="{Binding ElementName=FolderBox}" VerticalAlignment="Center" Margin="0,0,12,8" />
        <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" TextChanged="OnOptionChanged"
                 ToolTip="The folder of mp3 files to check. You can also drop a folder on the window." />
        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="0,0,0,8" Click="OnBrowse" />

        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <CheckBox x:Name="RecursiveBox" Content="Include subfolders" IsChecked="True" VerticalAlignment="Center"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
            <CheckBox x:Name="LogBox" Content="Write CSV log" IsChecked="True" Margin="24,0,0,0" VerticalAlignment="Center"
                      ToolTip="Writes mp3-log-YYYYMMDD-HHMMSS.csv to the folder, with every file's details, tags and errors." />
            <CheckBox x:Name="FixLettersBox" Content="Fix æ, ø, å" Margin="24,0,0,0" VerticalAlignment="Center"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Corrects letters shown as two characters, such as &quot;Ã¸&quot; for &quot;ø&quot;, in the tags and file names. Other letters such as ä, ö and é are corrected too." />
            <CheckBox x:Name="FixNamesBox" Content="Fix all file and folder names" Margin="24,0,0,0" VerticalAlignment="Center"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Also renames every other file and folder whose name has garbled letters, such as &quot;SÃ¸ren&quot; or &quot;S├©ren&quot; for &quot;Søren&quot;: covers, playlists, folders. Missing albums get the corrected folder name. Names that could be correct as they are, or that lost a letter, are only listed." />
            <CheckBox x:Name="FromNamesBox" Content="Tags from file names" Margin="24,0,0,0" VerticalAlignment="Center"
                      Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                      ToolTip="Fills in a missing Title, Artist, Track and Disc from file names such as &quot;1-02 Artist - Title.mp3&quot;, &quot;02 Artist - Title.mp3&quot; or &quot;Artist - Title.mp3&quot;. Tags that are already set are left alone." />
            <Label Content="Split _titles" Target="{Binding ElementName=SplitBox}" VerticalAlignment="Center" Margin="24,0,8,0" />
            <ComboBox x:Name="SplitBox" SelectedIndex="0" VerticalAlignment="Center" MinWidth="200" SelectionChanged="OnSplitChanged"
                      ToolTip="Moves the artist out of titles such as &quot;Artist / Title&quot; into the Artist tag. Automatic works out the order for each folder; check the result before applying.">
                <ComboBoxItem Content="Off" />
                <ComboBoxItem Content="Automatic, per folder" />
                <ComboBoxItem Content="Artist / Title" />
                <ComboBoxItem Content="Title / Artist" />
            </ComboBox>
        </WrapPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,12">
            <Button x:Name="AboutButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnAbout" ToolTip="About Mp3TagUpdater and updates"
                    AutomationProperties.Name="About Mp3TagUpdater">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" />
            </Button>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ScanButton" Content="Scan" MinWidth="96" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="OnScan"
                        ToolTip="Reads every mp3 and lists what would change. Nothing is written to the mp3 files." />
                <Button x:Name="ApplyButton" Content="Apply changes..." Margin="8,0,0,0" IsEnabled="False" Click="OnApply"
                        ToolTip="Writes the repairs, tag changes and new file names found by the last scan." />
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Margin="8,0,0,0" IsEnabled="False" Click="OnCancel" />
                <Button x:Name="OpenLogButton" Content="Open log" Margin="24,0,0,0" Visibility="Collapsed" Click="OnOpenLog" />
                <Button x:Name="OpenFolderButton" Content="Open folder" Margin="8,0,0,0" Visibility="Collapsed" Click="OnOpenFolder" />
            </StackPanel>
        </DockPanel>

        <ProgressBar x:Name="Bar" Grid.Row="3" Grid.ColumnSpan="3" Height="8" Margin="0,0,0,8" />

        <TextBlock x:Name="StatusText" Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"
                   Text="Choose a folder of mp3 files, then Scan. Nothing is changed until you apply." />

        <DockPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Label Content="_Show" Target="{Binding ElementName=FilterBox}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="FilterBox" MinWidth="240" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="OnFilterChanged">
                <ComboBoxItem x:Name="FilterAll" Content="All files" />
                <ComboBoxItem x:Name="FilterChanges" Content="Changes" />
                <ComboBoxItem x:Name="FilterUpdatable" Content="Updatable" />
                <ComboBoxItem x:Name="FilterProblems" Content="Errors and warnings" />
            </ComboBox>
            <CheckBox x:Name="HideOkBox" Content="Hide OK" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged"
                      ToolTip="Leaves out the files with OK status, which have nothing to change and no problems." />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" TextChanged="OnFilterChanged"
                     ToolTip="Show only files whose path, title, artist or album contains this text"
                     AutomationProperties.Name="Search" />
            <TextBlock Text="Search" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <DataGrid x:Name="FileGrid" Grid.Row="6" Grid.ColumnSpan="3"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Resources>
                <Style x:Key="CellText" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show in Explorer" Click="OnShowInExplorer" />
                    <MenuItem Header="Copy path" Click="OnCopyPath" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="StatusLabel" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Critical">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Caution">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Pending">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Success">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Neutral">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTrigger>
                                <!-- On the accent-coloured selection the status colours are hard to read. -->
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="2*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="#" Binding="{Binding Number}" SortMemberPath="NumberOrder" Width="Auto" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" SortMemberPath="Duration" Width="Auto" ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="Changes and errors" SortMemberPath="Details" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Details}" ToolTip="{Binding DetailsTooltip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
