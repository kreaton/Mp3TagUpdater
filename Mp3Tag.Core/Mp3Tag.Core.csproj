<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free scanning, repair and tagging API, used by the WPF app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mp3Tag.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mp3Tag.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- TagLibSharp provides read/write access to MP3 (ID3v1/ID3v2) tags -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mp3Tag.Text\Mp3Tag.Text.csproj" />
  </ItemGroup>

</Project>
